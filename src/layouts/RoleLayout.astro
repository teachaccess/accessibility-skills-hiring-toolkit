---
export interface Props {
  title: string;
  canonicalURL?: string;
}

const { title, canonicalURL } = Astro.props;

import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title={`${title} | Teach Access Accessibility Skills Hiring Toolkit`}
  canonicalURL={canonicalURL}
>
  <Header />
  <Breadcrumbs />

  <main>
    <div class="bg-sky-800 text-white px-4 py-4 mb-4">
      <h1 class="max-w-2xl mx-auto px-4 py-4 text-balance">
        {title}
      </h1>
    </div>
    <div class="max-w-2xl mx-auto px-4 bg-slate-50">
      <slot />
    </div>
  </main>

  <Footer />
</BaseLayout>
