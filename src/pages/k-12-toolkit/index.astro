---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import ncademiLogoVertical from "../../assets/ncademi-logo-vertical.png";
import ncademiLogoHorizontal from "../../assets/ncademi-logo-horizontal.png";
import { extractRoleTitle } from "../../utils/roleUtils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const roles = await getCollection("k12Roles", ({ data }) => !data.draft);
const rolesWithTitles = roles
  .map((role) => ({
    ...role,
    extractedTitle: extractRoleTitle(role),
  }))
  .sort((a, b) => a.extractedTitle.localeCompare(b.extractedTitle));
const baseURL = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="K-12 Toolkit | Teach Access Accessibility Skills Hiring Toolkit"
  description="Accessibility-focused job descriptions, qualifications, and interview questions for K-12 education roles."
>
  <Header />

  <main class="flex-1">
    <div class="role-content py-4">
      <h1>K-12 Toolkit</h1>

      <h2>About the Toolkit</h2>
      <p>
        Use this toolkit to incorporate accessibility-focused knowledge, skills,
        and sample pre-screening and interview questions into your K-12 job
        descriptions and hiring process.
      </p>

      <p>
        The K-12 Toolkit was developed in partnership with the <a
          href="https://ncademi.org/"
          target="_blank"
          rel="noopener noreferrer"
        >
          National Center on Accessible Digital Educational Materials &
          Instruction (NCADEMI)</a
        >.
      </p>

      <Image
        src={ncademiLogoVertical}
        alt="NCADEMI logo: National Center on Accessible Digital Educational Materials and Instruction."
        class="block sm:w-96 md:hidden h-auto w-full"
      />
      <Image
        src={ncademiLogoHorizontal}
        alt="NCADEMI logo: National Center on Accessible Digital Educational Materials and Instruction."
        class="hidden md:block h-auto w-full"
      />

      <h2>Job Positions</h2>
      <h3>Published Roles</h3>
      <ul class="list-disc pl-6">
        {
          rolesWithTitles.map((role) => (
            <li>
              <a href={`${baseURL}/k-12-toolkit/roles/${role.slug}`}>
                {role.extractedTitle}
              </a>
            </li>
          ))
        }
      </ul>

      <h3 id="submit-a-role">Submit a Role</h3>
      <p>
        We welcome contributions! <a href="https://forms.gle/dEafQn2x1F1641Jm9"
          >Fill out this form</a
        > to submit a role to the Accessibility Skills Hiring Toolkit.
      </p>

      <h2 id="creative-commons-license">Creative Commons License</h2>
      <p>
        Accessibility Skills Hiring Toolkit by Teach Access is licensed under a
        Creative Commons Attribution 4.0 International License. Interview
        questions adapted from Scott O'Hara's <a
          href="https://scottaohara.github.io/accessibility_interview_questions/"
          >Accessibility Interview Questions</a
        > open source resource.
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>
